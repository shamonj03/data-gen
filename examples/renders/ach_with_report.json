{
  "schema": "../schemas/ach.json",
  "outputs": [
    {
      "file": "ach_{now:%Y%m%d}.ach",
      "template": "../templates/nacha.ach.j2",
      "newline": "\r\n",
      "line_width": 94,
      "encoding": "ascii",
      "postprocess": [
        {
          "name": "block_pad",
          "size": 10,
          "fill": "9"
        }
      ]
    },
    {
      "file": "ach_report.csv",
      "template": "../templates/ach_entries_report.j2",
      "delimiter": ","
    }
  ]
}
